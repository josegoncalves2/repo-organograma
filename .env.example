# Copie para .env e preencha: cp .env.example .env

# Mesmo domínio da stack central (hub-login) — mantenha sincronizado
# com c:\Users\40446686808\projetos\hub-login\.env
DOMAIN=127.0.0.1.nip.io

# Senha da administracao, pedida em http://<host>:8085/login. Trocar a senha
# encerra as sessoes abertas. A visualizacao publica (/view/) nao pede senha.
# Vazia, o servidor nao sobe. Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(15).toString('base64url'))"
ADMIN_SENHA=
